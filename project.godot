[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

3d/physics_engine="Jolt Physics"
3d/physics_engine.web="GodotPhysics3D"

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/ssao/quality=3
environment/ssao/half_size=false
environment/ssao/fadeout_from=500.0
environment/ssao/fadeout_to=2000.0
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size.web=1024
anti_aliasing/quality/msaa_3d.web=1

